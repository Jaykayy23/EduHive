# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eduhive

# Google OAuth (server-side only)
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Stream Chat
NEXT_PUBLIC_STREAM_KEY=replace_with_public_stream_key
STREAM_SECRET=replace_with_server_side_stream_secret

# UploadThing
UPLOADTHING_TOKEN=replace_with_uploadthing_token

# NVIDIA Build API (server-side only; never use a NEXT_PUBLIC_ prefix)
NVIDIA_API_KEY=your_nvidia_build_api_key

# Optional tutor model and response limit
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_MAX_TOKENS=1500

# Keep this below the 60-second Vercel function duration.
NVIDIA_TIMEOUT_MS=55000

# Comma-separated immutable user IDs allowed to access moderation tools
ADMIN_USER_IDS=replace_with_immutable_user_id

# Protects the scheduled unused-upload cleanup route
CRON_SECRET=replace_with_a_long_random_secret

# Transactional authentication email delivery (server-side only)
RESEND_API_KEY=re_your_send_only_domain_restricted_key
EMAIL_FROM="EduHive <security@auth.eduhive.com>"
APP_URL=http://localhost:3000

# HiveQ is server-to-server only. Use the same 32+ character random key in
# ml-backend/.env and never expose either setting with a NEXT_PUBLIC_ prefix.
QUESTGEN_API_URL=http://127.0.0.1:8000
HIVEQ_INTERNAL_API_KEY=replace_with_at_least_32_random_characters
