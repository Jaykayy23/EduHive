ENVIRONMENT=development
GEMINI_API_KEY=replace-with-your-server-side-key
GEMINI_MODEL=gemini-2.5-flash
HIVEQ_INTERNAL_API_KEY=replace_with_the_same_32_character_key_as_nextjs
MAX_UPLOAD_MB=10
MAX_CONTEXT_CHARS=60000
MAX_PDF_PAGES=100
MAX_DOCX_ENTRIES=1000
MAX_DOCX_UNCOMPRESSED_MB=40
FILE_PARSE_TIMEOUT_SECONDS=15
FILE_PARSE_MEMORY_LIMIT_MB=256
MAX_CONCURRENT_FILE_PARSES=2
SUMMARY_MAX_WORDS=3500
PORT=8000
